# Proprietary firmware. Never commit any of this.
# See README.md for how to obtain the update image yourself.
*.img
*.exe
*.deb
*.zip
*.bz2
*.bz2.[0-9][0-9]

# Everything extracted from the firmware container: rootfs, kernel, device
# trees, vendor splash artwork. All of it is regenerated by
# _tools/az01-extract.py from the update image.
_extracted/

# Build artifacts of the QEMU VM. All regenerated by _tools/vm-build.sh, which
# downloads the Debian armhf kernel and busybox itself. Screenshots are the
# only thing kept, as documentation of the result.
_vm/*
!_vm/*.png

# SSH keypair generated by vm-build.sh for the guest.
id_vm
id_vm.pub

# The macOS app bundle, generated by _tools/mac-app.sh with the repository path
# baked in. It belongs to the machine that built it, not to the repository.
*.app/

# Local scratch
*.log
*.tmp
__pycache__/

# Local tooling config, not part of the project
.claude/
